{
  "name": "projet-final-labellevie",
  "version": "1.0.0",
  "description": "Tests E2E automatisés avec Playwright, POM et Gherkin sur Label'Vie",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:chromium": "npx playwright test --project=chromium",
    "test:firefox": "npx playwright test --project=firefox",
    "test:debug": "npx playwright test --debug",
    "bdd": "npx cucumber-js",
    "bdd:chromium": "BROWSER=chromium npx cucumber-js",
    "report": "npx playwright show-report",
    "codegen": "npx playwright codegen https://www.labellevie.com"
  },
  "keywords": [
    "playwright",
    "e2e",
    "testing",
    "bdd",
    "gherkin",
    "pom"
  ],
  "author": "Équipe Qualité Logicielle",
  "license": "MIT",
  "devDependencies": {
    "@cucumber/cucumber": "^10.3.1",
    "@playwright/test": "^1.56.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
